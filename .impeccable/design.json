      "html": "<a class=\"ds-download\" href=\"#portfolio\"><span><strong>UX portfolio</strong><small>17 pages \u00b7 PDF \u00b7 30.7 MB</small></span><svg viewBox=\"0 0 24 24\" fill=\"none\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></a>",
      "css": ".ds-download{font-family:var(--font-reading,\"Onest\",Arial,sans-serif);color:var(--ink,#1d1d1f);display:flex;justify-content:space-between;gap:20px;align-items:center;padding:24px 0;border-bottom:1px solid var(--line,#d8d8dc);text-decoration:none}.ds-download strong{font-size:17px;font-weight:500}.ds-download small{display:block;color:var(--muted,#626267);font-size:12px;margin-top:6px}.ds-download svg{width:22px;height:22px;flex:none}.ds-download:hover strong{text-decoration:underline;text-underline-offset:5px}.ds-download:focus-visible{outline:2px solid var(--ink,#1d1d1f);outline-offset:6px}"
