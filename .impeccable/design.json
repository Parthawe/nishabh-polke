      "kind": "custom",
      "refersTo": "artifact-disclosure",
      "description": "Native disclosure for the full evidence archive.",
      "html": "<details class=\"ds-disclosure\"><summary>View all research artifacts <span class=\"ds-plus\" aria-hidden=\"true\">+</span></summary><p class=\"ds-disclosure-body\">Original project documentation</p></details>",
      "css": ".ds-disclosure{font-family:var(--font-reading,\"Onest\",Arial,sans-serif);color:var(--ink,#1d1d1f);border-top:1px solid var(--line,#d8d8dc);border-bottom:1px solid var(--line,#d8d8dc)}.ds-disclosure summary{display:flex;justify-content:space-between;align-items:center;cursor:pointer;min-height:56px;padding:16px 0;font-size:14px;list-style:none}.ds-disclosure summary::-webkit-details-marker{display:none}.ds-plus{font-size:24px;font-weight:300;line-height:1}.ds-disclosure[open] .ds-plus{transform:rotate(45deg)}.ds-disclosure summary:hover{color:var(--ink,#1d1d1f)}.ds-disclosure summary:focus-visible{outline:2px solid var(--ink,#1d1d1f);outline-offset:6px}.ds-disclosure-body{font-size:13px;color:var(--muted,#626267);margin:0;padding:20px 0 36px}"
