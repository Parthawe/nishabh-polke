    {
      "name": "Stitch action",
      "kind": "button",
      "refersTo": "stitch-button",
      "description": "Ink-filled next-square action, visible pattern counter, and Undo; JavaScript supplies the reversible activity.",
      "html": "<button class=\"ds-stitch\" type=\"button\">Stitch next square <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/></svg></button><button class=\"ds-unpick\" type=\"button\" disabled>Undo last square</button><p class=\"ds-counter\">0 of 6 squares stitched</p>",
      "css": ".ds-stitch{font-family:var(--font-reading,\"Onest\",Arial,sans-serif);display:flex;gap:20px;align-items:center;padding:12px 19px;border:1px solid var(--ink,#1d1d1f);border-radius:999px;background:var(--ink,#1d1d1f);color:var(--paper,#f5f5f7);font-size:14px;cursor:pointer;min-height:48px}.ds-stitch svg{width:18px;height:18px}.ds-stitch:hover{background:var(--ink,#1d1d1f)}.ds-stitch:focus-visible{outline:2px solid var(--ink,#1d1d1f);outline-offset:6px}.ds-stitch:disabled{cursor:wait;opacity:.6}.ds-unpick{font-family:var(--font-reading,\"Onest\",Arial,sans-serif);border:0;background:none;color:var(--ink,#1d1d1f);text-decoration:underline;text-underline-offset:5px;padding:10px 0;min-height:44px;font-size:13px;cursor:pointer}.ds-unpick:disabled{opacity:.45;cursor:default}.ds-unpick:focus-visible{outline:2px solid var(--ink,#1d1d1f);outline-offset:6px}.ds-counter{font-family:var(--font-reading,\"Onest\",Arial,sans-serif);font-size:14px;color:var(--ink,#1d1d1f);font-variant-numeric:tabular-nums}"
