      "css": ".ds-lamp{display:flex;align-items:center;gap:3px;min-height:40px;background:var(--surface,#ececee);padding:4px;border-radius:999px}.ds-lamp button{font-family:var(--font-reading,\"Onest\",Arial,sans-serif);border:0;background:none;padding:9px 17px;border-radius:999px;min-height:40px;cursor:pointer;font-size:13px;color:var(--muted,#626267)}.ds-lamp button[aria-pressed=true]{background:var(--ink,#1d1d1f);color:var(--paper,#f5f5f7);text-decoration:none}.ds-lamp button:not([aria-pressed=true]):hover{color:var(--ink,#1d1d1f)}.ds-lamp button:focus-visible{outline:2px solid var(--ink,#1d1d1f);outline-offset:6px}@media(hover:hover) and (pointer:fine){.ds-lamp button[aria-pressed=false]:hover{background:rgb(29 29 31 / .06)}}"
